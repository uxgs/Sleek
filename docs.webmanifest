{
  "name": "Sleek Docs",
  "short_name": "Sleek Docs",
  "description": "Write pages in your browser. Everything saves as you go, and it works offline.",
  "id": "./docs.html",
  "start_url": "./docs.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0B0B0D",
  "theme_color": "#0B0B0D",
  "icons": [
    { "src": "icons/docs-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/docs-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/docs-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [
    { "action": "./docs.html", "accept": { "text/markdown": [".md", ".markdown"] } }
  ]
}
