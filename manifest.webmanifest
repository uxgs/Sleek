{
  "name": "Sleek Slides",
  "short_name": "Sleek Slides",
  "description": "Build and present decks in your browser. Everything saves as you go, and it works offline.",
  "id": "./",
  "start_url": "./slides.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0B0B0D",
  "theme_color": "#0B0B0D",
  "icons": [
    { "src": "icons/slides-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/slides-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/slides-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [
    { "action": "./slides.html", "accept": { "application/x-sleek+json": [".sleek"] } }
  ]
}
